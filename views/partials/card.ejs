<article class="product-card"><a class="card-image" href="<%= url('/product/'+p.slug) %>" tabindex="-1" aria-hidden="true"><% if(p.images.length){const image=p.images[0]; %><img src="<%= image.variants[1].src %>" srcset="<%= image.variants.map(v=>v.src+' '+v.width+'w').join(', ') %>" sizes="(max-width: 550px) 45vw, (max-width: 1024px) 30vw, 300px" width="<%= image.width %>" height="<%= image.height %>" alt="" loading="lazy" decoding="async"><% } %><span class="card-image-arrow">↗</span></a><div class="card-body"><p class="card-category"><%= cat(p.category) %></p><h3><a href="<%= url('/product/'+p.slug) %>"><%= loc(p.title) %></a></h3><p class="card-spec"><%= p.properties.filter(s=>!['Çatdırılma?','Yeni?'].includes(s.name)).slice(0,2).map(s=>prop(s.value)).join(' / ') %></p><div class="card-bottom"><strong><%= money(p) %></strong><a href="<%= url('/product/'+p.slug) %>" aria-label="<%= t('details')+': '+loc(p.title) %>"><%= t('details') %> <span>↗</span></a></div></div></article>
