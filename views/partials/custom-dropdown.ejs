<% const selectedOption = options.find(option => String(option.value) === String(value)) || options[0]; const listId = id + '-options'; %>
<div class="custom-dropdown<%= variant ? ' custom-dropdown--' + variant : '' %>" data-custom-dropdown data-value="<%= value %>">
<% if(name){ %><input type="hidden" id="<%= id %>-input" name="<%= name %>" value="<%= value %>" data-dropdown-input><% } %>
<button id="<%= id %>" class="custom-dropdown__trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="<%= listId %>"><% if(variant === 'language'){ %><span class="custom-dropdown__globe" aria-hidden="true">◎</span><% } %><span data-dropdown-label><%= selectedOption.label %></span><span class="custom-dropdown__chevron" aria-hidden="true"></span></button>
<div id="<%= listId %>" class="custom-dropdown__menu" role="listbox" aria-labelledby="<%= id %>" tabindex="-1">
<% for(const option of options){ const selected = String(option.value) === String(value); %><% if(option.href){ %><a class="custom-dropdown__option<%= selected ? ' is-selected' : '' %>" role="option" aria-selected="<%= selected %>" data-dropdown-option data-value="<%= option.value %>" href="<%= option.href %>"<% if(option.lang){ %> lang="<%= option.lang %>" hreflang="<%= option.lang %>"<% } %>><span><%= option.label %></span><span class="custom-dropdown__check" aria-hidden="true">✓</span></a><% } else { %><button class="custom-dropdown__option<%= selected ? ' is-selected' : '' %>" type="button" role="option" aria-selected="<%= selected %>" data-dropdown-option data-value="<%= option.value %>"><span><%= option.label %></span><span class="custom-dropdown__check" aria-hidden="true">✓</span></button><% } %><% } %>
</div></div>
