<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title><meta name="description" content="<%= metaDescription %>">
<meta name="robots" content="<%= noindex ? 'noindex,follow' : 'index,follow' %>"><link rel="canonical" href="<%= canonical %>">
<% for(const alternate of alternates){ %><link rel="alternate" hreflang="<%= alternate.lang %>" href="<%= alternate.url %>"><% } %>
<link rel="alternate" hreflang="x-default" href="<%= alternates[0].url %>">
<meta property="og:type" content="<%= product ? 'product' : 'website' %>"><meta property="og:site_name" content="AyvaTech"><meta property="og:title" content="<%= title %>"><meta property="og:description" content="<%= metaDescription %>"><meta property="og:url" content="<%= canonical %>"><meta property="og:image" content="<%= ogImage %>"><meta property="og:locale" content="<%= {az:'az_AZ',ru:'ru_RU',en:'en_GB'}[lang] %>">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="<%= title %>"><meta name="twitter:description" content="<%= metaDescription %>"><meta name="twitter:image" content="<%= ogImage %>">
<meta name="theme-color" content="#202020"><link rel="icon" href="/media/ayvatech-icon.png" type="image/png"><link rel="apple-touch-icon" href="/media/ayvatech-icon.png">
<link rel="stylesheet" href="/style.css"><script src="/site.js" defer></script>
<% if(!admin){ %><script type="application/ld+json"><%- jsonSafe(structured) %></script><% } %>
<% if(admin){ %><meta name="csrf-token" content="<%= csrf %>"><script src="/admin.js" defer></script><% } %>
</head>
<body class="<%= admin?'admin-body':'' %>">
<a class="skip-link" href="#main"><%= t('skip') %></a>
<div class="topbar"><div class="container topbar-inner"><span><%= loc(shop.promo) %></span><a href="tel:<%= shop.phones[0].replace(/[^+\d]/g,'') %>"><%= shop.phones[0] %> <span class="topbar-hours">/ <%= t('hours') %> <%= shop.workingHours %></span></a></div></div>
<header class="header"><div class="container header-inner">
<a href="<%= url('/') %>" class="brand" aria-label="AyvaTech"><img src="/media/ayvatech-logo.png" width="2122" height="889" alt="AyvaTech"></a>
<nav class="desktop-nav" aria-label="<%= t('menu') %>"><a href="<%= url('/') %>" <%- routePath==='/'?'aria-current="page"':'' %>><%= t('home') %></a><a href="<%= url('/catalog') %>" <%- routePath==='/catalog'?'aria-current="page"':'' %>><%= t('catalog') %></a><a href="<%= url('/#categories') %>"><%= t('categories') %></a><a href="<%= url('/about') %>"><%= t('about') %></a><a href="<%= url('/contact') %>"><%= t('contact') %></a></nav>
<div class="header-actions"><a class="button button-primary header-cta" href="tel:<%= shop.phones[0].replace(/[^+\d]/g,'') %>"><%= t('call') %> ↗</a><a class="search-link" href="<%= url('/catalog#search') %>" aria-label="<%= t('search') %>"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a><div class="language-dropdown"><button class="language-dropdown-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="language-options"><span><%= lang.toUpperCase() %></span><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></button><div id="language-options" class="language-dropdown-menu" role="listbox" aria-label="<%= t('language') %>" hidden><% for(const language of ['az','ru','en']){ %><a class="language-dropdown-option" role="option" href="<%= languageLinks[language] %>" lang="<%= language %>" aria-selected="<%= language===lang %>" tabindex="-1"><span><%= language.toUpperCase() %></span><span class="language-check" aria-hidden="true"><%= language===lang?'✓':'' %></span></a><% } %></div></div><button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="<%= t('menu') %>"><span></span><span></span></button></div>
</div><nav id="mobile-menu" class="mobile-nav" hidden><a href="<%= url('/') %>"><%= t('home') %></a><a href="<%= url('/catalog') %>"><%= t('catalog') %></a><a href="<%= url('/#categories') %>"><%= t('categories') %></a><a href="<%= url('/about') %>"><%= t('about') %></a><a href="<%= url('/contact') %>"><%= t('contact') %></a><a href="<%= url('/catalog#search') %>"><%= t('search') %></a><a class="button button-primary" href="tel:<%= shop.phones[0].replace(/[^+\d]/g,'') %>"><%= t('call') %> ↗</a></nav></header>
