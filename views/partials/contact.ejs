<section class="contact-section"><div class="container contact-grid"><div><p class="eyebrow"><%= t('contact') %> / AYVATECH</p><h2><%= t('questions') %></h2><p><%= t('questionsText') %></p><a class="contact-phone" href="tel:<%= shop.phones[0].replace(/[^+\d]/g,'') %>"><%= shop.phones[0] %> ↗</a></div><div class="contact-address"><h3><%= t('visit') %></h3><p><%= shop.address %></p><p><%= t('hours') %><br><strong><%= shop.workingHours %></strong></p><a class="text-link" href="https://www.google.com/maps?q=<%= shop.latitude %>,<%= shop.longitude %>" target="_blank" rel="noopener noreferrer"><%= t('directions') %> ↗</a></div></div></section>
