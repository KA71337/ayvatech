<form class="filters" action="<%= admin?'/admin':url('/catalog') %>" method="get"><div class="filter-title"><h2><%= t('filters') %></h2><a href="<%= admin?'/admin':url('/catalog') %>"><%= t('reset') %></a></div>
<label for="search"><%= t('search') %></label><input id="search" name="q" type="search" value="<%= query.q||'' %>" placeholder="<%= t('searchHint') %>" maxlength="300">
<label for="category"><%= t('categories') %></label><%- include('custom-dropdown', { id: 'category', name: 'category', value: query.category || '', options: [{value:'',label:t('all')}, ...[...new Map(products.map(p=>[p.categorySlug,p])).values()].map(p=>({value:p.categorySlug,label:cat(p.category)}))], variant: '' }) %>
<fieldset><legend><%= t('price') %>, AZN</legend><div class="price-fields"><input aria-label="<%= t('minimum') %>" placeholder="<%= t('minimum') %>" type="number" name="min" min="0" step="0.01" value="<%= query.min||'' %>"><span>—</span><input aria-label="<%= t('maximum') %>" placeholder="<%= t('maximum') %>" type="number" name="max" min="0" step="0.01" value="<%= query.max||'' %>"></div></fieldset>
<label for="brand"><%= t('brand') %></label><%- include('custom-dropdown', { id: 'brand', name: 'brand', value: query.brand || '', options: [{value:'',label:t('all')}, ...[...new Set(products.map(p=>p.brand).filter(Boolean))].map(brand=>({value:brand,label:prop(brand)}))], variant: '' }) %>
<label for="spec"><%= t('specs') %></label><%- include('custom-dropdown', { id: 'spec', name: 'spec', value: query.spec || '', options: [{value:'',label:t('all')}, ...[...new Map(products.flatMap(p=>p.properties).map(s=>[s.name+'::'+s.value,s])).values()].map(spec=>({value:spec.name+'::'+spec.value,label:prop(spec.name)+': '+prop(spec.value)}))], variant: '' }) %>
<label for="availability"><%= t('availability') %></label><%- include('custom-dropdown', { id: 'availability', name: 'availability', value: query.availability || '', options: [{value:'',label:t('all')}, ...[...new Set(products.map(p=>p.availability).filter(Boolean))].map(availability=>({value:availability,label:t(availability)}))], variant: '' }) %>
<% if(admin){ %><label for="status"><%= t('status') %></label><%- include('custom-dropdown', { id: 'status', name: 'status', value: query.status || '', options: [{value:'',label:t('all')}, ...['published','draft','archived'].map(status=>({value:status,label:t(status)}))], variant: '' }) %><% } %>
<label for="sort"><%= t('sort') %></label><%- include('custom-dropdown', { id: 'sort', name: 'sort', value: query.sort || 'newest', options: [['newest','newest'],['price-asc','lowPrice'],['price-desc','highPrice'],['name','nameSort']].map(([value,label])=>({value,label:t(label)})), variant: '' }) %><button class="button button-dark" type="submit"><%= t('apply') %> →</button></form>
