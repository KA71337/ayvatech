<form class="filters" action="<%= admin?'/admin':url('/catalog') %>" method="get"><div class="filter-title"><h2><%= t('filters') %></h2><a href="<%= admin?'/admin':url('/catalog') %>"><%= t('reset') %></a></div>
<label for="search"><%= t('search') %></label><input id="search" name="q" type="search" value="<%= query.q||'' %>" placeholder="<%= t('searchHint') %>" maxlength="300">
<label for="category"><%= t('categories') %></label><select id="category" name="category"><option value=""><%= t('all') %></option><% for(const p of [...new Map(products.map(p=>[p.categorySlug,p])).values()]){ %><option value="<%= p.categorySlug %>" <%= query.category===p.categorySlug?'selected':'' %>><%= cat(p.category) %></option><% } %></select>
<fieldset><legend><%= t('price') %>, AZN</legend><div class="price-fields"><input aria-label="<%= t('minimum') %>" placeholder="<%= t('minimum') %>" type="number" name="min" min="0" step="0.01" value="<%= query.min||'' %>"><span>—</span><input aria-label="<%= t('maximum') %>" placeholder="<%= t('maximum') %>" type="number" name="max" min="0" step="0.01" value="<%= query.max||'' %>"></div></fieldset>
<label for="brand"><%= t('brand') %></label><select id="brand" name="brand"><option value=""><%= t('all') %></option><% for(const brand of [...new Set(products.map(p=>p.brand).filter(Boolean))]){ %><option value="<%= brand %>" <%= query.brand===brand?'selected':'' %>><%= prop(brand) %></option><% } %></select>
<label for="spec"><%= t('specs') %></label><select id="spec" name="spec"><option value=""><%= t('all') %></option><% for(const spec of [...new Map(products.flatMap(p=>p.properties).map(s=>[s.name+'::'+s.value,s])).values()]){ %><option value="<%= spec.name+'::'+spec.value %>" <%= query.spec===spec.name+'::'+spec.value?'selected':'' %>><%= prop(spec.name) %>: <%= prop(spec.value) %></option><% } %></select>
<label for="availability"><%= t('availability') %></label><select id="availability" name="availability"><option value=""><%= t('all') %></option><% for(const availability of [...new Set(products.map(p=>p.availability).filter(Boolean))]){ %><option value="<%= availability %>" <%= query.availability===availability?'selected':'' %>><%= t(availability) %></option><% } %></select>
<% if(admin){ %><label for="status"><%= t('status') %></label><select id="status" name="status"><option value=""><%= t('all') %></option><% for(const s of ['published','draft','archived']){ %><option value="<%= s %>" <%= query.status===s?'selected':'' %>><%= t(s) %></option><% } %></select><% } %>
<label for="sort"><%= t('sort') %></label><select id="sort" name="sort"><% for(const [value,label] of [['newest','newest'],['price-asc','lowPrice'],['price-desc','highPrice'],['name','nameSort']]){ %><option value="<%= value %>" <%= query.sort===value?'selected':'' %>><%= t(label) %></option><% } %></select><button class="button button-dark" type="submit"><%= t('apply') %> →</button></form>
