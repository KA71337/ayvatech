<%- include('partials/head') %>
<main id="main" class="container editor"><div class="admin-heading"><div><p class="eyebrow">AYVATECH / İDARƏETMƏ</p><h1><%= t(product?'edit':'add') %></h1></div><a class="text-link" href="/admin">← <%= t('admin') %></a></div>
<form id="product-editor" data-product="<%= JSON.stringify(product) %>" data-revision="<%= revision %>" data-saved="<%= t('saved') %>" data-error="<%= t('error') %>" data-delete-confirm="<%= t('deleteConfirm') %>" data-remove="<%= t('remove') %>" data-left="<%= t('moveLeft') %>" data-right="<%= t('moveRight') %>" data-field="<%= t('field') %>" data-value="<%= t('value') %>" data-image-invalid="<%= t('imageInvalid') %>">
<div class="editor-grid"><section class="editor-section"><h2><%= t('title') %> / <%= t('description') %></h2><p><%= t('fallback') %></p><% for(const language of ['az','ru','en']){ %><div class="localization" lang="<%= language %>"><h3><%= language.toUpperCase() %></h3><label for="title-<%= language %>"><%= t('title') %> <%= language.toUpperCase() %></label><input id="title-<%= language %>" name="title.<%= language %>" maxlength="300" value="<%= product?.title[language]||'' %>" <%= language==='az'?'required':'' %>><label for="description-<%= language %>"><%= t('description') %> <%= language.toUpperCase() %></label><textarea id="description-<%= language %>" name="description.<%= language %>" maxlength="25000" <%= language==='az'?'required':'' %>><%= product?.description[language]||'' %></textarea><label for="category-<%= language %>"><%= t('categories') %> <%= language.toUpperCase() %></label><input id="category-<%= language %>" name="category.<%= language %>" maxlength="160" value="<%= product?.category[language]||'' %>" <%= language==='az'?'required':'' %>></div><% } %></section>
<div><section class="editor-section"><h2><%= t('specs') %></h2><p><%= t('adminNote') %></p><label for="slug"><%= t('slug') %></label><input id="slug" name="slug" required maxlength="160" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="<%= product?.slug||'' %>"><label for="categorySlug"><%= t('categorySlug') %></label><input id="categorySlug" name="categorySlug" required maxlength="100" pattern="[a-z0-9\-]+" value="<%= product?.categorySlug||'' %>"><label for="price"><%= t('price') %></label><input id="price" name="price" type="number" required min="0" max="10000000" step="0.01" value="<%= product?.price??'' %>"><label for="currency"><%= t('currency') %></label><%- include('partials/custom-dropdown', { id: 'currency', name: 'currency', value: product?.currency || 'AZN', options: ['AZN','USD','EUR'].map(value=>({value,label:value})), variant: '' }) %><% for(const field of ['brand','model','condition']){ %><label for="<%= field %>"><%= t(field) %></label><input id="<%= field %>" name="<%= field %>" maxlength="<%= field==='condition'?100:160 %>" value="<%= product?.[field]||'' %>"><% } %><label for="availability"><%= t('availability') %></label><%- include('partials/custom-dropdown', { id: 'availability', name: 'availability', value: product?.availability || '', options: ['','InStock','LimitedAvailability','OutOfStock','PreOrder'].map(value=>({value,label:t(value||'confirmStock')})), variant: '' }) %><label for="status"><%= t('status') %></label><%- include('partials/custom-dropdown', { id: 'status', name: 'status', value: product?.status || 'draft', options: ['draft','published','archived'].map(value=>({value,label:t(value)})), variant: '' }) %><div id="spec-editor"></div><button type="button" class="button button-light" id="add-spec"><%= t('addSpec') %> +</button></section>
<section class="editor-section"><h2><%= t('images') %></h2><p><%= t('imageHelp') %></p><label for="image-upload"><%= t('upload') %></label><input id="image-upload" type="file" accept="image/jpeg,image/png,image/webp" multiple><div class="editor-images" id="editor-images"></div></section></div></div>
<div class="editor-bar"><button class="button button-primary" type="submit"><%= t('save') %> ✓</button><a class="button button-light" href="/admin"><%= t('cancel') %></a><% if(product){ %><button class="button button-light danger" type="button" id="delete-product"><%= t('remove') %></button><dialog id="delete-dialog" class="confirm-dialog"><form method="dialog"><h2><%= t('deleteConfirm') %></h2><div><button class="button button-light" value="cancel">Xeyr</button><button class="button button-dark danger" id="confirm-delete" value="confirm">Bəli</button></div></form></dialog><% } %><p id="editor-message" class="form-message" role="status" hidden></p></div>
</form></main><%- include('partials/footer') %>
