<%- include('partials/head') %><main id="main" class="product-page"><div class="container"><nav class="breadcrumbs"><a href="<%= url('/') %>"><%= t('home') %></a><span>/</span><a href="<%= url('/catalog') %>"><%= t('catalog') %></a><span>/</span><a href="<%= url('/catalog?category='+product.categorySlug) %>"><%= cat(product.category) %></a></nav>
<div class="product-layout"><section class="gallery" aria-label="<%= t('gallery') %>"><button class="gallery-main" data-open-gallery aria-label="<%= t('gallery') %>"><img id="main-product-image" src="<%= product.images[0].src %>" srcset="<%= product.images[0].variants.map(v=>v.src+' '+v.width+'w').join(', ') %>" sizes="(max-width:768px) 95vw, 55vw" width="<%= product.images[0].width %>" height="<%= product.images[0].height %>" alt="<%= loc(product.title) %>" fetchpriority="high"><span>↗ <%= t('gallery') %> / <%= product.images.length %></span></button><div class="gallery-thumbs"><% product.images.forEach((image,i)=>{ %><button data-image="<%= image.src %>" data-original="<%= image.original %>" data-srcset="<%= image.variants.map(v=>v.src+' '+v.width+'w').join(', ') %>" aria-label="<%= t('gallery')+' '+(i+1) %>" aria-pressed="<%= i===0 %>"><img src="<%= image.variants[0].src %>" alt="" width="80" height="80" loading="lazy"></button><% }) %></div></section>
<section class="product-summary"><p class="eyebrow"><%= cat(product.category) %></p><h1><%= loc(product.title) %></h1><p class="product-ref">ID / <%= product.sourceId||product.id %></p><div class="product-price"><%= money(product) %></div><p class="availability"><span class="status-dot"></span><%= t(product.availability||'confirmStock') %></p><p class="stock-note"><%= t('sourceNote') %></p><dl class="summary-specs"><% for(const spec of product.properties.slice(0,4)){ %><div><dt><%= prop(spec.name) %></dt><dd><%= prop(spec.value) %></dd></div><% } %></dl><a class="button button-primary product-cta" href="tel:<%= shop.phones[0].replace(/[^+\d]/g,'') %>"><%= t('call') %> ↗</a><% if(product.sourceUrl){ %><a class="source-link" href="<%= product.sourceUrl %>" target="_blank" rel="noopener noreferrer"><%= t('source') %> ↗</a><% } %><div class="product-store"><img src="<%= shop.logo.variants[0].src %>" alt="" width="48" height="48"><div><strong>AyvaTech</strong><p><%= t('hours') %> · <%= shop.workingHours %></p></div></div></section></div>
<div class="product-information"><section><h2><%= t('description') %></h2><div class="description-text"><%= loc(product.description) %></div><% if(product.sourceUpdatedAt){ %><p class="updated-note"><%= t('updated') %>: <%= new Intl.DateTimeFormat(lang,{dateStyle:'medium'}).format(new Date(product.sourceUpdatedAt)) %></p><% } %></section><section><h2><%= t('specs') %></h2><dl class="spec-table"><% for(const spec of product.properties){ %><div><dt><%= prop(spec.name) %></dt><dd><%= prop(spec.value) %></dd></div><% } %><% if(product.model){ %><div><dt><%= t('model') %></dt><dd><%= product.model %></dd></div><% } %></dl></section></div>
<% if(related.length){ %><section class="section"><div class="section-heading"><h2><%= t('related') %></h2><a class="text-link" href="<%= url('/catalog?category='+product.categorySlug) %>"><%= t('all') %> ↗</a></div><div class="product-grid"><% for(const p of related){ %><%- include('partials/card',{p}) %><% } %></div></section><% } %></div>
<dialog class="lightbox" aria-label="<%= t('gallery') %>"><button class="lightbox-close" aria-label="<%= t('close') %>">×</button><button class="lightbox-prev" aria-label="<%= t('previous') %>">←</button><img src="<%= product.images[0].original %>" alt="<%= loc(product.title) %>" loading="lazy"><button class="lightbox-next" aria-label="<%= t('next') %>">→</button><span class="lightbox-counter"></span></dialog>
</main><%- include('partials/footer') %>
