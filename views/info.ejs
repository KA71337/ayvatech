<%- include('partials/head') %><main id="main"><section class="container info-page"><p class="eyebrow">AYVATECH / BAKU</p><h1><%= t(kind) %></h1><% if(kind==='about'){ %><div class="about-grid"><div><h2><%= t('aboutTitle') %></h2><p><%= t('aboutText') %></p><p><%= loc(shop.promo) %></p><a class="button button-primary" href="<%= url('/catalog') %>"><%= t('browse') %> ↗</a></div><img src="<%= shop.cover.src %>" alt="AyvaTech" width="<%= shop.cover.width %>" height="<%= shop.cover.height %>"></div><% }else if(kind==='privacy'){ %><p><%= t('privacyText') %></p><% }else if(kind==='notFound'){ %><p>404</p><a class="button button-dark" href="<%= url('/catalog') %>"><%= t('browse') %> ↗</a><% } %></section><% if(['about','contact'].includes(kind)){ %><%- include('partials/contact') %><% } %></main><%- include('partials/footer') %>
