<%- include('partials/head') %><main id="main" class="container catalogue"><nav class="breadcrumbs"><a href="<%= url('/') %>"><%= t('home') %></a><span>/</span><span><%= t('catalog') %></span></nav><div class="page-heading"><div><p class="eyebrow">AYVATECH COLLECTION</p><h1><%= t('catalog') %><span class="count"><%= products.length %></span></h1></div><p><%= t('collectionText') %></p></div><button class="button filter-toggle" aria-expanded="false" aria-controls="filter-panel"><%= t('filters') %> +</button><div class="catalogue-layout"><aside id="filter-panel"><%- include('partials/filters') %></aside><div><div class="results-bar"><span><strong><%= result.total %></strong> <%= t('products') %></span><span><%= result.page %> / <%= result.pages %></span></div><% if(!result.total){ %><div class="empty-state"><span>↗</span><h2><%= t('noResults') %></h2><p><%= t('tryAgain') %></p><a class="button button-dark" href="<%= url('/catalog') %>"><%= t('reset') %></a></div><% } %><div class="product-grid catalogue-products"><% for(const p of result.items){ %><%- include('partials/card',{p}) %><% } %></div><%- include('partials/pagination') %></div></div></main><script type="application/json" id="catalog-data"><%- jsonSafe(products) %></script>
<% for(const p of products){ %><template data-card="<%= p.id %>"><%- include('partials/card',{p}) %></template><% } %>
<template id="catalog-empty"><div class="empty-state"><h2><%= t('noResults') %></h2><p><%= t('tryAgain') %></p><a href="<%= url('/catalog') %>"><%= t('reset') %></a></div></template>
<script type="module" src="/catalog.js"></script>
<%- include('partials/footer') %>
