<%- include('partials/head') %>
<main id="main" class="container"><section class="login-panel"><p class="eyebrow">AYVATECH / <%= t('admin') %></p><h1><%= t('login') %></h1>
<% if(!configured){ %><p class="form-message" role="status"><%= t('setup') %></p><% } %>
<% if(error){ %><p class="form-message" role="alert"><%= error %></p><% } %>
<form method="post" action="/api/admin/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="password"><%= t('password') %></label><div class="password-field"><input type="password" id="password" name="password" autocomplete="current-password" maxlength="1024" required autofocus><button type="button" class="password-toggle" data-show="Şifrəni göstər" data-hide="Şifrəni gizlət" aria-label="Şifrəni göstər" aria-pressed="false"><span aria-hidden="true">👁</span></button></div><button class="button button-dark" type="submit" <%= configured?'':'disabled' %>><%= t('login') %> →</button></form>
</section></main><%- include('partials/footer') %>
