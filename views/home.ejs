<%- include('partials/head') %>
<main id="main">
<% const categoryList=[...new Map(products.map(p=>[p.categorySlug,{slug:p.categorySlug,name:p.category,image:p.images[0]}])).values()]; %>
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span><%= t('heroLabel') %></p><h1><% t('heroTitle').split('\n').forEach((line,i)=>{ %><span class="<%= i?'muted-title':'' %>"><%= line %></span><% }) %></h1><p class="hero-description"><%= t('heroText') %></p><div class="hero-buttons"><a class="button button-primary" href="<%= url('/catalog') %>"><%= t('browse') %> <span>↗</span></a><a class="text-link" href="<%= url('/contact') %>"><%= t('contact') %> →</a></div><div class="hero-index"><span>01 /</span><p><%= t('collection') %><small><%= products.length %> <%= t('products') %> · AyvaTech</small></p></div></div>
<div class="hero-space" aria-hidden="true"><span>AYVATECH</span></div>
</div></section>
<section class="container categories-section" id="categories"><div class="section-heading"><div><p class="eyebrow">01 / <%= t('categories') %></p><h2><%= t('collection') %></h2></div><a class="text-link" href="<%= url('/catalog') %>"><%= t('all') %> ↗</a></div><div class="category-grid"><% categoryList.forEach((c,i)=>{ %><a class="category-tile" href="<%= url('/catalog?category='+c.slug) %>"><span class="category-number"><%= String(i+1).padStart(2,'0') %></span><img src="<%= c.image.variants[0].src %>" width="150" height="130" alt="" loading="lazy"><div><h3><%= cat(c.name) %></h3><span><%= products.filter(p=>p.categorySlug===c.slug).length %> <%= t('products') %></span></div><span class="category-arrow">↗</span></a><% }) %></div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">02 / AYVATECH SELECT</p><h2><%= t('selected') %></h2></div><p class="heading-note"><%= t('collectionText') %></p></div><div class="product-grid"><% for(const id of ['48266940','48378278','48622112','48252204']){const p=products.find(p=>p.sourceId===id);if(p){ %><%- include('partials/card',{p}) %><% }} %></div></section>
<section class="editorial"><div class="container editorial-grid"><div class="editorial-visual"><img src="<%= shop.cover.src %>" srcset="<%= shop.cover.variants.map(v=>v.src+' '+v.width+'w').join(', ') %>" sizes="(max-width:768px) 100vw, 55vw" width="<%= shop.cover.width %>" height="<%= shop.cover.height %>" alt="AyvaTech" loading="lazy"><span>AYVATECH / BAKU</span></div><div class="editorial-copy"><p class="eyebrow"><%= t('storeLabel') %></p><h2><%= t('aboutTitle') %></h2><p><%= t('aboutText') %></p><a class="button button-light" href="<%= url('/about') %>"><%= t('about') %> ↗</a></div></div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">03 / <%= t('newest') %></p><h2><%= t('newProducts') %></h2></div><a class="text-link" href="<%= url('/catalog?sort=newest') %>"><%= t('browse') %> ↗</a></div><div class="product-grid"><% for(const p of [...products].sort((a,b)=>(b.sourceUpdatedAt||b.importedAt||'').localeCompare(a.sourceUpdatedAt||a.importedAt||'')).slice(0,4)){ %><%- include('partials/card',{p}) %><% } %></div></section>
<section class="container advantages"><% for(const [i,key] of ['direct','transparent','local'].entries()){ %><div><span class="advantage-icon"><%= ['↗','≡','⌖'][i] %></span><h3><%= t(key) %></h3><p><%= t(key+'Text') %></p></div><% } %></section>
<%- include('partials/contact') %>
</main><%- include('partials/footer') %>
