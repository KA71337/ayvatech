<%- include('partials/head') %><main id="main" class="container catalogue"><div class="admin-heading"><div><p class="eyebrow">AYVATECH / ADMIN</p><h1><%= t('admin') %></h1></div><div class="admin-actions"><a class="button button-primary" href="/admin/product/new"><%= t('add') %> +</a><form action="/api/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button button-dark"><%= t('logout') %> ↗</button></form></div></div><button class="button filter-toggle" aria-expanded="false" aria-controls="filter-panel"><%= t('filters') %> +</button><div class="catalogue-layout"><aside id="filter-panel"><%- include('partials/filters') %></aside><section><div class="results-bar"><span><%= result.total %> <%= t('products') %></span><span><%= result.page %> / <%= result.pages %></span></div><div class="admin-list"><% for(const p of result.items){ %><article class="admin-row"><% if(p.images.length){ %><img src="<%= p.images[0].src %>" alt="" width="70" height="70" loading="lazy"><% } %><div><h2><a href="/admin/product/<%= p.id %>"><%= loc(p.title) %></a></h2><p><%= money(p) %> · <%= t(p.status) %> · <%= cat(p.category) %></p></div><a class="button button-light" href="/admin/product/<%= p.id %>"><%= t('edit') %> ↗</a></article><% } %></div><% if(!result.total){ %><div class="empty-state"><h2><%= t('noResults') %></h2></div><% } %><%- include('partials/pagination') %></section></div></main><%- include('partials/footer') %>
